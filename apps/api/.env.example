# ─────────────────────────────────────────────────────────
# WorkFlow API — environment template
# Copy to apps/api/.env and adjust. Never commit the real .env.
# ─────────────────────────────────────────────────────────

# Server
PORT=4000

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL="postgresql://workflow:workflow@localhost:5432/workflow?schema=public"

# JWT (access tokens are signed; refresh tokens are random + hashed, no secret needed)
# JWT_ACCESS_SECRET is REQUIRED in production — the API refuses to boot without it.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
